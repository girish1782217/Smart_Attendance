ENVIRONMENT=development

# SQLite by default for dev/test (Assumption A-1 in docs/sdd/00-product-spec.md).
# For production, point this at PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/smart_attendance
DATABASE_URL=sqlite:///./dev.db

# Generate a real random value for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google Gemini — never commit a real key. Backend-only; never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=10

# Comma-separated list of allowed frontend origins. Vite bumps to 5174,
# 5175, etc. if 5173 is already taken locally, so both are allowed by
# default — check the terminal output of `npm run dev` for the actual port
# and extend this list if it lands on something else. A request from an
# origin not listed here fails silently in the browser (CORS), not with a
# helpful backend error.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

LOW_ATTENDANCE_DEFAULT_THRESHOLD=75.0

LOG_LEVEL=INFO
